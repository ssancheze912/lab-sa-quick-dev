{
  "name": "siesa-ui-kit",
  "private": false,
  "version": "1.0.245",
  "description": "SIESA UI Kit - Biblioteca de componentes React con Tailwind CSS, Storybook y agentes Claude AI",
  "type": "module",
  "main": "dist/siesa-ui-kit.cjs",
  "module": "dist/siesa-ui-kit.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/siesa-ui-kit.mjs",
      "require": "./dist/siesa-ui-kit.cjs"
    },
    "./styles.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:lib": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate-llms": "storybook-llms-extractor --config llms.config.json",
    "patch-storybook": "node scripts/patch-storybook.cjs"
  },
  "keywords": [
    "siesa",
    "ui-kit",
    "react",
    "tailwindcss",
    "storybook",
    "components",
    "design-system",
    "claude-ai"
  ],
  "author": "Sistemas de Información Empresarial",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "src/components/FormCacheSelector/locales/**/*",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "framer-motion": "^12.35.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0",
    "sonner": "^2.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "react-hook-form": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "zustand": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "dependencies": {
    "@casl/ability": "^6.8.0",
